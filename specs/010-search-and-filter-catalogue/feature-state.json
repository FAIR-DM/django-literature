  "gates": {
    "spec": {
      "approved_by": "SamuelJennings",
      "at": "2026-08-20T10:20:00Z",
      "self_resolved": [
        "Search matches case-insensitive fragments, not whole words or prefixes",
        "Search covers citation key, three title fields, container title and contributor family, given and literal names; abstract and keywords excluded",
        "Contributor matching reaches the literal name so organizations stay findable",
        "The year filter reads the issued slot, accepts a year-only date, and excludes references with no issued date",
        "The language filter offers the values the catalogue holds, as stored",
        "Values within a filter widen; filters and the search narrow",
        "An invalid or unmatched filter value reports no matches rather than erroring or falling back",
        "The contributor page is unchanged, holding the boundary FS-009 drew",
        "#88 is absorbed and closed by this feature",
        "Indexing withdrawn at the gate: an ordinary index cannot serve a fragment search, and the alternative requires a database extension"
      ]
    },
