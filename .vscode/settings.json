{
    // =====================================
    // COPILOT / SPECKIT SETTINGS
    // =====================================
    "chat.promptFilesRecommendations": {
        "speckit.constitution": true,
        "speckit.specify": true,
        "speckit.plan": true,
        "speckit.tasks": true,
        "speckit.implement": true
    },
    "chat.tools.terminal.autoApprove": {
        ".specify/scripts/bash/": true,
        ".specify/scripts/powershell/": true
    },
    // =====================================
    // FILE ASSOCIATIONS
    // =====================================
    "files.associations": {
        "**/templates/**/*.html": "django-html"
    },
    // Files to exclude from explorer and search
    "files.exclude": {
        "**/__pycache__": true,
        "**/.pytest_cache": true,
        "**/.mypy_cache": true,
        "**/.ruff_cache": true,
        "**/.coverage": true,
        "**/.hypothesis": true,
        "htmlcov": true,
        "**/*.pyc": true,
        "**/migrations/__pycache__": true
    },
    // =====================================
    // PYTHON SETTINGS
    // =====================================
    "python.defaultInterpreterPath": "${workspaceFolder}/.venv/Scripts/python",
    "python.terminal.activateEnvironment": true,
    "python.analysis.autoFormatStrings": true,
    "python.analysis.autoImportCompletions": true,
    "python.analysis.typeCheckingMode": "basic",
    "python.analysis.exclude": [
        "**/node_modules",
        "**/__pycache__",
        "**/build",
        "**/docs",
        "**/dist",
        "**/migrations",
        "**/fixtures",
        "**/venv",
        "**/.venv",
        "**/.pytest_cache",
        "**/.mypy_cache",
        "**/.ruff_cache",
        "**/.github",
        "**/.specify"
    ],
    "python.testing.pytestEnabled": true,
    "python.testing.unittestEnabled": false,
    "python.testing.pytestArgs": [
        "tests",
        "--doctest-modules"
    ],
    "[python]": {
        "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
        },
        "editor.defaultFormatter": "charliermarsh.ruff",
        "editor.formatOnSave": true,
        "editor.formatOnType": true,
        "editor.rulers": [
            120
        ],
        "files.eol": "\n"
    },
    // =====================================
    // RUFF SETTINGS
    // =====================================
    "ruff.lineLength": 120,
    "ruff.fixAll": true,
    "ruff.organizeImports": true,
    // =====================================
    // MYPY SETTINGS
    // =====================================
    "mypy.runUsingActiveInterpreter": true,
    "mypy.targets": [
        "literature"
    ],
    // =====================================
    // DJANGO SETTINGS
    // =====================================
    "emmet.includeLanguages": {
        "django-html": "html"
    },
    "djlint.showInstallError": false,
    "djlint.useEditorIndentation": false,
    "[django-html]": {
        "editor.codeActionsOnSave": {
            "source.fixAll": "explicit"
        },
        "editor.defaultFormatter": "monosans.djlint",
        "editor.formatOnSave": true,
        "editor.rulers": [
            119
        ],
        "editor.tabSize": 2,
        "files.eol": "\n"
    },
    // =====================================
    // JAVASCRIPT/TYPESCRIPT SETTINGS
    // =====================================
    "[javascript][typescript]": {
        "editor.codeActionsOnSave": {
            "source.fixAll": "explicit",
            "source.organizeImports": "explicit"
        },
        "editor.formatOnSave": true,
        "editor.insertSpaces": true,
        "editor.tabSize": 2
    },
    "javascript.format.insertSpaceAfterConstructor": true,
    "javascript.format.semicolons": "remove",
    "javascript.updateImportsOnFileMove.enabled": "always",
    "typescript.format.insertSpaceAfterConstructor": true,
    "typescript.format.semicolons": "remove",
    "typescript.updateImportsOnFileMove.enabled": "always",
    // =====================================
    // CSS/SASS/SCSS SETTINGS
    // =====================================
    "[sass][scss]": {
        "editor.defaultFormatter": "sibiraj-s.vscode-scss-formatter",
        "editor.formatOnSave": true,
        "editor.tabSize": 2
    },
    // =====================================
    // HTML SETTINGS
    // =====================================
    "[html]": {
        "editor.defaultFormatter": "vscode.html-language-features",
        "editor.formatOnSave": true,
        "editor.tabSize": 2
    },
    // =====================================
    // JSON SETTINGS
    // =====================================
    "[json]": {
        "editor.defaultFormatter": "vscode.json-language-features",
        "editor.formatOnSave": true,
        "editor.tabSize": 2
    },
    // =====================================
    // MARKDOWN SETTINGS
    // =====================================
    "[markdown]": {
        "editor.wordWrap": "on",
        "editor.tabSize": 2
    },
    // =====================================
    // GENERAL EDITOR SETTINGS
    // =====================================
    "editor.rulers": [
        120
    ],
    "editor.wordWrap": "on",
    "editor.formatOnSave": true,
    "editor.tabSize": 4,
    "editor.insertSpaces": true,
    "editor.trimAutoWhitespace": true,
    "files.trimTrailingWhitespace": true,
    "files.insertFinalNewline": true,
    "files.eol": "\n",
    // =====================================
    // GIT SETTINGS
    // =====================================
    "git.autofetch": true,
    "git.confirmSync": false,
    "git.enableSmartCommit": true,
    // =====================================
    // TESTING SETTINGS
    // =====================================
    "testing.automaticallyOpenTestResults": "neverOpen",
    "testing.openTesting": "neverOpen",
    // =====================================
    // DEBUGGING SETTINGS
    // =====================================
    "debug.inlineValues": "off",
    "debug.terminal.clearBeforeReusing": true
}
